# Railway will automatically provide DATABASE_URL when you add PostgreSQL
# Keep this for local development only

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/conference_db

# API server port (Railway sets this automatically)
PORT=5000

# Admin credentials - CHANGE THESE IN PRODUCTION!
ADMIN_PASSWORD=iitkgp_professor_admin
ADMIN_KEY=conf2026admin

# Environment (development or production)
NODE_ENV=development